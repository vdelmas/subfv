  t_max = 1.0
  cfl = 0.2

  scheme = 'SCHEME_PLACEHOLDER'
  second_order = .false.

  init = 11
  gresho_mach = MACH_PLACEHOLDER

  n_sol_vtu = 21
  n_bc=0
  /
