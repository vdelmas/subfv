&INPUT_PARAM
  meshfile_path=''
  meshfile='MESH_PLACEHOLDER'

  boundary_2d = .true.

  sol_uniform=1.0, 0., 0., 0., 1.0,

  ! one full rotation of the inner core is t = 2*pi/5 ~ 1.2566; the vortex is a
