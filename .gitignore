# Build
build/

# Fortran compiled artifacts
*.mod
*.o
*.a

# Executables
subfvns
subfvshear
subfvacoustic
subfvlagrange

# Test outputs (generated by the solver)
outputs/
outputs_conv/

# Mesh files (generated by gmsh from .geo)
*.msh

# Generated parametric meshes for test_error_heat_flux_hybrid
test/test_error_heat_flux_hybrid/meshes/

# Generated figures and reports
*.pdf
*.png
*.vtu
*.vtk
*.pvtu

# Generated plot data and run artifacts
*_plots/
output_*.dat
run.timestamp
*.sh.o*
*.sh.e*
plot_line

# Run logs and computed error arrays
log_*.txt
log.txt
log_array_*.txt
err_array_*.txt
scaling_mpi.txt

# Computed result data (errors, residuals)
errors_*.dat
residuals_*.dat
residual.dat

# LaTeX bibliography artifacts
*.bbl
*.bcf
*.blg


# LaTeX auxiliary files
*.aux
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz

# Generated animations (same rationale as *.png above)
*.gif
*.jpg

# Generated polyhedral meshes (same rationale as *.msh above: rebuilt by
# tools/voronoi/*.py, and a single Voronoi mesh is ~1-3 MB)
*.cgns

# Simulation output tables. The solver writes <rank>_output_<n>.dat, and the
# post-processing writes extracted profiles; neither belongs in the repository.
*.dat

# ...but analytic and exact reference solutions ARE tracked. They are inputs to
# the comparison, not output of it, and test/sedov_tri/analytic_sedov_2D.dat and
# its two siblings were already tracked before this rule existed. These negations
# have no effect inside outputs/ or build/, which are excluded wholesale.
!*analytic*.dat
!*exact*.dat
!ref_*.dat
!*_ref.dat

# LaTeX report directories are not tracked, sources included. This is the
# repository's established convention, not a new decision: tex_ale,
# tex_arbitrary_high_order, tex_comparison_classic_iso, tex_lagrange_o2,
# tex_lagrange_ph and tex_vilar have never had a single tracked file. The rule is
# written down here because tex_all_mach_number_scheme was briefly added in
# 077ab25 and removed again -- the convention was invisible until someone broke it.
tex_*/
